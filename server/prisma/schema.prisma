// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  expenses Expense[]
  incomes Income[]
  budgets Budget[]
  goals   Goal[]
}

model Budget {
  id        Int      @id @default(autoincrement())
  category  String
  amount    Float    // monthly limit for this category
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  @@unique([userId, category])
}

model Goal {
  id           Int      @id @default(autoincrement())
  name         String
  targetAmount Float
  savedAmount  Float    @default(0)
  createdAt    DateTime @default(now())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  @@index([userId])
}

model Expense {
  id          Int     @id @default(autoincrement())
  amount      Float
  category    String 
  description String?
  createdAt   DateTime @default(now())
  userId      Int
  user        User @relation(fields: [userId], references: [id])
  @@index([userId, createdAt, id])
}

model Income {
  id          Int      @id @default(autoincrement())
  amount      Float
  source      String   // categories like "salary", "freelance", "investment" etc.
  description String?
  createdAt   DateTime @default(now())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  @@index([userId, createdAt, id])

}
